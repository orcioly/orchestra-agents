{
  // Reference snippet for ~/.config/opencode/opencode.jsonc
  // Orchestra needs a "reviewer" (read-only) agent in OpenCode.
  // Note: pinning "model" is NOT required — without it, the agent uses the
  // default model you already configured in OpenCode. Add "model" only
  // if you want the reviewer to use a model different from the default.
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "reviewer": {
      "description": "Code review: correção, regressões, segurança, performance e testes faltando",
      "mode": "primary",
      "prompt": "Você é um revisor de código sênior. Analise o diff/alterações informados. Liste objetivamente: bugs, regressões, riscos de segurança e performance, e testes faltando. Seja direto. Termine SEMPRE com uma linha 'VEREDITO: APROVADO' ou 'VEREDITO: REPROVADO' seguida dos itens a corrigir.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  }
}
