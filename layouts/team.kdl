// Orchestra Agents — layout TIME
// LÍDER (Claude) em cima (largura total); embaixo CODER | REVISOR (TUIs reais do OpenCode).
// Subido por:  orchestra up
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="horizontal" {
        pane name="LÍDER (Claude)" size="45%" command="bash" {
            args "-lc" "exec ${ORCHESTRA_HOME:-$HOME/.orchestra-agents}/agents/leader.sh"
        }
        pane split_direction="vertical" {
            pane name="CODER" command="bash" {
                args "-lc" "exec ${ORCHESTRA_HOME:-$HOME/.orchestra-agents}/agents/attach-worker.sh coder"
            }
            pane name="REVISOR" command="bash" {
                args "-lc" "exec ${ORCHESTRA_HOME:-$HOME/.orchestra-agents}/agents/attach-worker.sh reviewer"
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
