#!/usr/bin/env bash
# Orchestra Agents — CLI do orquestrador
set -uo pipefail
ORCHESTRA_HOME="${ORCHESTRA_HOME:-$HOME/.orchestra-agents}"

VERSION="0.2.0"

usage() {
  cat <<'EOF'
🎼 Orchestra Agents — orquestrador de IA no terminal (time de N agentes no zellij)

uso:
  orchestra [dir]                 sobe o time no zellij (padrão: diretório atual) e abre o
                                  menu de composição: líder + agentes, cada um rodando
                                  claude | opencode | codex.
  orchestra send <agente> <txt>   despacha uma tarefa (ASSÍNCRONO, não bloqueia)
  orchestra result <agente>       última resposta do agente (não-bloqueante)
  orchestra result <agente> --wait [timeout]
                                  BLOQUEIA até a resposta completa (padrão 300s)
  orchestra await <agente> [timeout]
                                  alias de 'result <agente> --wait'
  orchestra done <agente> <task>  (usado PELO agente) devolve a resposta, lendo stdin

  orchestra agents                lista o time e o estado de cada painel
  orchestra add <nome> [--ia claude|opencode|codex] [--role <papel>]
                       [--prompt "<o que ele faz>"]
                                  (--ia é a IA que roda o agente; --backend é sinônimo)
                                  cria um agente e abre o painel na hora
  orchestra rm <nome>             remove o agente e fecha o painel
  orchestra leader <backend>      troca o líder (claude | opencode | codex)
  orchestra heal                  recria painéis de agentes que morreram/foram fechados

  orchestra status                estado da sessão e dos agentes
  orchestra doctor                diagnostica pré-requisitos, backends e painéis
  orchestra down                  encerra a sessão do time
  orchestra uninstall             remove o Orchestra Agents por completo
  orchestra version               versão

papéis prontos: coder, reviewer, tester, docs, architect, devops
                (qualquer outro nome vira um agente 'custom' com prompt editável
                 em .orchestra/prompts/<nome>.md)

exemplos:
  orchestra
  orchestra ~/meu-projeto
  orchestra send coder    "crie um endpoint POST /users com validação"
  orchestra await coder
  orchestra add tester --backend claude --role tester
  orchestra add gitops --backend claude --prompt "Cuida de git: commit e push, mensagens no padrão do repo. NÃO altera código."
  orchestra leader codex
EOF
}

# Subir o time é a ação PADRÃO: 'orchestra' (aqui) ou 'orchestra <dir>' (lá).
# Não existe subcomando para isso — 'orchestra up' era redundante e confundia.
# Continua aceito, sem estar documentado, para não quebrar quem já o usava.
cmd="${1:-}"; [ $# -gt 0 ] && shift
if [ "$cmd" = up ]; then
  echo "ℹ️  o 'up' não é mais necessário — basta 'orchestra' (ou 'orchestra <dir>')."
  cmd="${1:-}"; [ $# -gt 0 ] && shift
fi
case "$cmd" in
  send|done|result|await|agents|team|ls|add|rm|remove|leader|heal|status|doctor|down|uninstall|version|-v|--version|help|-h|--help) ;;
  *)
    # vazio ou um diretório existente => subir o time (fixa o projeto ANTES do core,
    # que resolve os diretórios de runtime a partir dele)
    if [ -z "$cmd" ] || [ -d "$cmd" ]; then
      proj="${cmd:-$PWD}"
      proj="$(cd "$proj" 2>/dev/null && pwd)" || { echo "❌ diretório inválido: '$cmd'"; exit 1; }
      export ORCHESTRA_PROJECT="$proj"
      cmd=__subir
    else
      # parece caminho e não existe: dizer isso, em vez de "comando desconhecido"
      case "$cmd" in
        /*|./*|../*|~*|*/*) echo "❌ diretório não encontrado: '$cmd'" >&2; exit 1 ;;
      esac
    fi ;;
esac

# shellcheck source=/dev/null
. "$ORCHESTRA_HOME/lib/core.sh"

case "$cmd" in
  __subir)
    command -v zellij >/dev/null 2>&1 || { echo "❌ zellij não encontrado no PATH"; exit 1; }
    if [ -n "${ZELLIJ:-}" ]; then
      echo "⚠️  você já está dentro de uma sessão zellij."
      echo "    Saia para um terminal normal e rode 'orchestra' de novo (evita aninhar)."
      exit 1
    fi
    printf '%s' "$ORCHESTRA_PROJECT" >"$ORCHESTRA_STATE/project"
    mkdir -p "$ORCHESTRA_RUN_DIR"
    # o runtime é descartável; o time (team.json/prompts) é versionável
    printf 'run/\n' >"$ORCHESTRA_DIR/.gitignore"
    echo "🎼 subindo Orchestra no projeto: $ORCHESTRA_PROJECT"

    team_ensure
    # select_team devolve 2 quando o usuário escolhe "sair" no menu
    select_team; sel_rc=$?
    if [ "$sel_rc" = 2 ]; then
      echo "  ✋ cancelado — o zellij não foi aberto."
      exit 0
    fi

    # valida que todo backend escolhido está instalado
    miss=0
    for n in $(team_all_names); do
      b="$(team_field "$n" backend)"
      backend_available "$b" || { echo "❌ '$n' usa '$b', que não está instalado — $(backend_url "$b")"; miss=1; }
    done
    [ "$miss" = 0 ] || exit 1

    # o OpenCode precisa do agente 'reviewer' configurado (idempotente)
    for n in $(team_all_names); do
      [ "$(team_field "$n" backend)" = opencode ] && { ensure_reviewer_agent; break; }
    done

    layout="$(generate_layout)"
    echo "  ✔ time: $(team_all_names | tr '\n' ' ')"

    # nome de sessão estável por projeto → rodar 'orchestra' de novo reanexa em vez de
    # falhar. A montagem vive em lib/mux.sh (é conceito de multiplexador) e encurta
    # sozinha quando o zellij não aceita o nome inteiro — ver mux_session_name.
    sess="$(mux_session_name "$ORCHESTRA_PROJECT")"
    printf '%s' "$sess" >"$ORCHESTRA_STATE/mux.session"
    line="$(zellij list-sessions --no-formatting 2>/dev/null | grep -E "^${sess}( |\$)" || true)"
    if [ -n "$line" ]; then
      case "$line" in
        *EXITED*) zellij delete-session --force "$sess" >/dev/null 2>&1 ;;
        *) echo "  🔁 sessão '$sess' já está no ar — reanexando…"; exec zellij attach "$sess" ;;
      esac
    fi
    echo "  🎬 abrindo o zellij…"
    # '-n/--new-session-with-layout' e NÃO '--layout': combinado com '--session', o
    # '--layout' significa "adicione este layout como aba à sessão EXISTENTE" e falha
    # com "Session not found" quando ela ainda não existe. O '-n' sempre cria.
    exec zellij -s "$sess" -n "$layout"
    ;;

  send)   dispatch "$@" ;;
  done)   done_reply "${1:-}" "${2:-}" ;;

  result)
    role="${1:-}"
    if [ "$role" = "--wait" ]; then
      result_wait "${2:-}" "${3:-$ORCHESTRA_TIMEOUT}"
    elif [ "${2:-}" = "--wait" ]; then
      result_wait "$role" "${3:-$ORCHESTRA_TIMEOUT}"
    else
      result "$role"
    fi
    ;;

  await)
    # 1º argumento = agente; 2º (opcional) = timeout, que PRECISA ser numérico —
    # um valor inválido é erro de validação (exit 1), nunca um default silencioso.
    role="${1:-}"; timeout="${2:-$ORCHESTRA_TIMEOUT}"
    if [ $# -gt 2 ]; then
      echo "uso: orchestra await <agente> [timeout_segundos]" >&2; exit 1
    fi
    result_wait "$role" "$timeout" "await"
    ;;

  agents|team|ls) agents_list ;;

  add)
    name="${1:-}"; [ $# -gt 0 ] && shift
    backend=""; role=""; ptext=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --backend|-b|--ia) backend="${2:-}"; shift 2 ;;
        --role|-r)    role="${2:-}";    shift 2 ;;
        --prompt|-p)  ptext="${2:-}";   shift 2 ;;
        *) echo "opção desconhecida: '$1'"; exit 1 ;;
      esac
    done
    agent_add "$name" "$backend" "$role" "$ptext"
    ;;

  rm|remove)  agent_rm "${1:-}" ;;
  leader)     leader_set "${1:-}" ;;
  heal)       heal ;;
  status)     status ;;
  doctor)     doctor ;;
  down)       teardown ;;

  uninstall)
    if [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then uninstall; exit 0; fi
    printf "Isso remove o Orchestra Agents POR COMPLETO. Confirmar? [y/N] "
    read -r ans </dev/tty || ans=n
    case "$ans" in y|Y|s|S) uninstall ;; *) echo "cancelado" ;; esac
    ;;

  version|-v|--version) echo "orchestra-agents $VERSION" ;;
  ""|help|-h|--help)    usage ;;
  *) echo "comando desconhecido: '$cmd'"; echo; usage; exit 1 ;;
esac
