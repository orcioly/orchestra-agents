#!/usr/bin/env bash
# Orchestra Agents — CLI do orquestrador
set -uo pipefail
ORCHESTRA_HOME="${ORCHESTRA_HOME:-$HOME/.orchestra-agents}"
# shellcheck source=/dev/null
. "$ORCHESTRA_HOME/lib/core.sh"

VERSION="0.1.0"

usage() {
  cat <<'EOF'
🎼 Orchestra Agents — orquestrador de IA (Claude líder + workers OpenCode/Codex)

uso:
  orchestra up [dir]            sobe o time no zellij (LÍDER + CODER + REVISOR)
                               no projeto 'dir' (padrão: diretório atual).
                               PERGUNTA qual backend usar em cada papel: opencode | codex
                               (env ORCHESTRA_CODER / ORCHESTRA_REVIEWER sobrescreve p/ CI)
  orchestra send <papel> <txt> despacha tarefa de forma ASSÍNCRONA (não bloqueia)
                               papel: coder | reviewer
  orchestra result <papel>     mostra a última resposta do worker (não-bloqueante)
  orchestra result <papel> --wait [timeout_segundos]
                               BLOQUEIA até resposta completa (padrão 300s)
  orchestra await <papel> [timeout_segundos]
                               alias de 'result <papel> --wait'
  orchestra status             estado do servidor e das sessões
  orchestra doctor             diagnostica pré-requisitos, modelo, agente e servidor
  orchestra down               encerra o servidor OpenCode
  orchestra uninstall          remove o Orchestra Agents por completo
  orchestra version            versão

exemplos:
  orchestra up ~/meu-projeto
  orchestra send coder    "crie um endpoint POST /users com validação"
  orchestra send reviewer "revise as últimas mudanças e aponte bugs"
  orchestra result coder --wait
  orchestra await reviewer 120
EOF
}

# sem argumento, 'orchestra' já entra (= up no diretório atual)
cmd="${1:-up}"; [ $# -gt 0 ] && shift
case "$cmd" in
  up)
    proj="${1:-$PWD}"
    proj="$(cd "$proj" 2>/dev/null && pwd)" || { echo "diretório inválido: ${1:-$PWD}"; exit 1; }
    command -v zellij >/dev/null 2>&1 || { echo "❌ zellij não encontrado no PATH"; exit 1; }
    if [ -n "${ZELLIJ:-}" ]; then
      echo "⚠️  você já está dentro de uma sessão zellij."
      echo "    Saia para um terminal normal e rode 'orchestra' de novo (evita aninhar)."
      exit 1
    fi
    echo "$proj" >"$ORCHESTRA_STATE/project"
    echo "🎼 subindo Orchestra no projeto: $proj"
    ensure_reviewer_agent   # auto-configura o agente revisor no OpenCode (idempotente)

    # escolha do backend de cada papel (opencode|codex) — menu VISUAL (setas).
    # env ORCHESTRA_CODER/REVIEWER sobrescreve; sem tty cai no default.
    read -r coder_backend reviewer_backend <<<"$(select_backends)"
    printf '%s' "$coder_backend"    >"$ORCHESTRA_STATE/coder.backend"
    printf '%s' "$reviewer_backend" >"$ORCHESTRA_STATE/reviewer.backend"
    echo "  ✔ coder=$coder_backend · reviewer=$reviewer_backend"

    # valida disponibilidade do codex se algum papel o usar
    if [ "$coder_backend" = codex ] || [ "$reviewer_backend" = codex ]; then
      if ! command -v codex >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/codex" ]; then
        echo "❌ codex não encontrado no PATH — instale (https://developers.openai.com/codex/cli) ou escolha opencode"; exit 1
      fi
    fi

    # sobe os servidores necessários
    if [ "$coder_backend" = opencode ] || [ "$reviewer_backend" = opencode ]; then
      printf '  ⏳ subindo servidor OpenCode...'; ensure_server \
        && echo ' ok' || { echo; echo "❌ servidor OpenCode não subiu — veja $ORCHESTRA_STATE/server.log"; exit 1; }
    fi
    if [ "$coder_backend" = codex ] || [ "$reviewer_backend" = codex ]; then
      printf '  ⏳ subindo Codex app-server...'; ensure_codex_server \
        && echo ' ok' || { echo; echo "❌ codex app-server não subiu — veja $ORCHESTRA_STATE/codex-server.log"; exit 1; }
    fi

    # workers FRESCOS a cada 'up' → começa com contexto limpo
    printf '  ⏳ preparando CODER (%s)...' "$coder_backend"
    ensure_worker coder "CODER (executor)" fresh >/dev/null \
      && echo ' ok' || { echo; echo "❌ falha ao preparar o coder — veja $ORCHESTRA_STATE/codex-server.log"; exit 1; }
    printf '  ⏳ preparando REVISOR (%s)...' "$reviewer_backend"
    ensure_worker reviewer "REVISOR (code review)" fresh >/dev/null \
      && echo ' ok' || { echo; echo "❌ falha ao preparar o reviewer — veja $ORCHESTRA_STATE/codex-server.log"; exit 1; }
    echo "  🎬 abrindo o zellij..."
    exec zellij --layout "$ORCHESTRA_HOME/layouts/team.kdl"
    ;;
  send)     dispatch "$@" ;;
  result)
    role="${1:-}"
    if [ "$role" = "--wait" ]; then
      # BLOCKER 2: $2 = papel, $3 = timeout (opcional)
      role="${2:-}"; timeout="${3:-300}"
      result_wait "$role" "$timeout"
    elif [ "${2:-}" = "--wait" ]; then
      # 'result <papel> --wait [timeout]'
      timeout="${3:-300}"
      result_wait "$role" "$timeout"
    else
      result "$role"
    fi
    ;;
  await)
    role=""; timeout=300
    for a in "$@"; do
      case "$a" in
        coder|reviewer) role="$a" ;;
        *) [[ "$a" =~ ^[0-9]+$ ]] && timeout="$a" ;;  # BLOCKER 1: só dígitos puros
      esac
    done
    result_wait "${role:-${1:-}}" "$timeout" "await"
    ;;
  status)   status ;;
  doctor)   doctor ;;
  down)     teardown ;;
  uninstall)
    if [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then uninstall; exit 0; fi
    printf "Isso remove o Orchestra Agents POR COMPLETO. Confirmar? [y/N] "
    read -r ans </dev/tty || ans=n
    case "$ans" in y|Y|s|S) uninstall ;; *) echo "cancelado" ;; esac
    ;;
  version|-v|--version) echo "orchestra-agents $VERSION" ;;
  ""|help|-h|--help)    usage ;;
  *) echo "comando desconhecido: '$cmd'"; echo; usage; exit 1 ;;
esac
