# runtime state (normally generated in ~/.local/state/orchestra-agents)
# and agent runtime inside each project (team.json IS versionable)
.orchestra/run/
*.session
server.log
.run/
run/
state/

# common junk
*.log
.DS_Store
__pycache__/
*.pyc

# local Claude context (do not version)
CLAUDE.md
CLAUDE.local.md
.claude

# Python bytecode cache (generated when importing merge_reviewer in tests)
__pycache__/
*.pyc

# graphify knowledge graph (generated; the post-checkout/post-commit hooks rebuild it)
graphify-out/
